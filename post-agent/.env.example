# Provider defaults to opencode when --provider is omitted.
POST_AGENT_PROVIDER=opencode

# Optional provider model overrides.
POST_AGENT_OPENCODE_MODEL=
POST_AGENT_CODEX_MODEL=
POST_AGENT_CLAUDE_CODE_MODEL=
POST_AGENT_CLAUDE_MODEL=claude-3-7-sonnet-latest

# Optional web-search provider. When omitted, the no-key DuckDuckGo fallback is used.
TAVILY_API_KEY=

# Optional absolute path if the project is moved.
POST_AGENT_PROJECT_ROOT=
