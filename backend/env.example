# Phone OTP provider. Use `mock` only for local development.
PHONE_OTP_PROVIDER=2factor
TWO_FACTOR_API_KEY=
# Optional 2Factor DLT/template name configured in your 2Factor dashboard.
TWO_FACTOR_OTP_TEMPLATE=
# Use a separate random secret in production; falls back to JWT_SECRET if omitted.
OTP_HASH_SECRET=
