<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 15 (API 35) and later: the app is edge-to-edge by default and
         statusBarColor / navigationBarColor are deprecated no-ops, so they are
         deliberately dropped from this variant.

         enforceNavigationBarContrast is NOT a no-op here: it defaults to true
         and paints an 80% opaque scrim across 3-button navigation, which turns
         the bar black over the app's dark-navy background. It must stay false.
         Bar icon brightness is also driven from Dart via SystemUiOverlayStyle;
         windowLightNavigationBar only seeds it before the first Flutter frame. -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/app_background</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:enforceNavigationBarContrast">false</item>
    </style>
</resources>
